{
  "name": "dsh-context-diet",
  "version": "0.1.0",
  "description": "Context diet for dsh: reshape tool results before they land, slim old history only when the cache it would destroy is idle, and audit the three ledgers that disagree about your hit rate.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./audit": "./lib/audit.js",
    "./codefold": "./lib/codefold.js",
    "./core": "./lib/core.js",
    "./fold": "./lib/fold.js",
    "./policy": "./lib/policy.js",
    "./prune": "./lib/prune.js"
  },
  "files": [
    "lib",
    "scripts",
    "tests/stubs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify-apply.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "context",
    "compression",
    "cache",
    "token"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOLECA794/dsh-context-diet.git"
  }
}